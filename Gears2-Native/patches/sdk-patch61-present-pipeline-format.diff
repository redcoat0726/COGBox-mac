+
+// macOS port diagnostic: a file trace of the presenter's swapchain and paint-pipeline events. The presenter stalls in
+// Metal shader compilation inside PaintAndPresentImpl - REXLOG goes to the in-game console there, which nobody can read
+// in a frozen game, so these go to <cwd>/logs/present-trace.log and survive the freeze.
+REXCVAR_DEFINE_BOOL(gow2_present_trace, false, "UI/Presenter",
+                     "Write every swapchain format change, paint-pipeline creation and paint start to "
+                     "logs/present-trace.log with a millisecond timestamp. Off by default: a line and a flush a frame "
+                     "cost more than they are worth until a stall is being chased");
+static void PresentTrace(const char* what, unsigned a = 0, unsigned b = 0) {
+  if (!REXCVAR_GET(gow2_present_trace)) return;
+  static FILE* f = [] {
+    std::error_code ec;
+    const std::filesystem::path dir = std::filesystem::current_path() / "logs";
+    std::filesystem::create_directories(dir, ec);
+    return std::fopen((dir / "present-trace.log").string().c_str(), "a");
+  }();
+  if (!f) return;
+  static const auto origin = std::chrono::steady_clock::now();
+  const auto ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - origin).count();
+  std::fprintf(f, "%lld %s %u %u\n", (long long)ms, what, a, b);
+  std::fflush(f);
+}
